# Copy to .env and fill in. Keep this file OUT of git.
# Get a key at https://console.anthropic.com/ (or use `claude` interactive
# login instead and leave this blank).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Web-terminal login. Format: user:password. Pick a real password.
TTYD_CREDENTIAL=admin:change-me-please

# Optional: your timezone, e.g. America/New_York
TZ=Etc/UTC
